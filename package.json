{
  "name": "chh-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "chh: a free, cross-platform SSH client and terminal manager",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chh/desktop dev",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @chh/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @chh/desktop test:e2e",
    "rebuild:electron": "pnpm --filter @chh/desktop rebuild:electron"
  }
}
