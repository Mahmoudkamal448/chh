    "@chh/ssh-config": "workspace:*",
    "@chh/sync-core": "workspace:*",
    "@chh/vault-crypto": "workspace:*",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "pino": "^10.4.0",
    "serialport": "^13.0.0",
    "sodium-native": "^5.1.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
