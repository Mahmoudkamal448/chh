# Required
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SERVER_SECRET=

# Optional
# Set to false after creating your accounts to stop new sign-ups.
ALLOW_REGISTRATION=true
# Where the server listens on the host. Keep 127.0.0.1 when using the tls profile or your own reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Set to true when behind a reverse proxy (the tls profile does this for you).
TRUST_PROXY=false
LOG_LEVEL=info
# For `docker compose --profile tls up -d`: your public host name, e.g. sync.example.com
DOMAIN=

# Upgrading a server set up before the project was renamed from cy-ssh? Keep using the existing
# database volume and credentials by uncommenting these three lines (see docs/SELF_HOSTING.md).
# COMPOSE_PROJECT_NAME=cy-ssh
# POSTGRES_USER=cyssh
# POSTGRES_DB=cyssh
